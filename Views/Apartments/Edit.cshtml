@model Apartment_Project.Models.Apartment
@using System

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit Apartment</h1>

<form asp-action="Edit" method="post" enctype="multipart/form-data" class="row g-3">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ID" />

    <div class="col-12">
        @if (Model?.SomePhoto != null)
        {
            var base64 = Convert.ToBase64String(Model.SomePhoto);
            <img id="existingPhoto" src="data:image;base64,@base64" alt="Existing photo" class="img-thumbnail mb-3" style="max-height:200px;" />
        }
    </div>

    <div class="col-md-6">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Location" class="form-label"></label>
        <input asp-for="Location" class="form-control" />
        <span asp-validation-for="Location" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="ListingType" class="form-label"></label>
        <select asp-for="ListingType" class="form-select">
            <option value="Rent">For Rent</option>
            <option value="Sale">For Sale</option>
        </select>
        <span asp-validation-for="ListingType" class="text-danger"></span>
    </div>

    <div class="col-md-4 form-check align-self-end">
        <input asp-for="IsAvailable" class="form-check-input" />
        <label asp-for="IsAvailable" class="form-check-label"></label>
    </div>

    <div class="col-12">
        <label asp-for="PhotoFile" class="form-label">Replace photo (optional)</label>
        <input asp-for="PhotoFile" type="file" accept="image/*" class="form-control image-preview" data-preview-target="#preview" />
        <span asp-validation-for="PhotoFile" class="text-danger"></span>
    </div>

    <div class="col-12">
        <img id="preview" class="img-thumbnail" style="max-height:200px; display:none;" alt="New photo preview" />
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-secondary">Back to list</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
