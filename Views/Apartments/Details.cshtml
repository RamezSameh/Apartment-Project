@model Apartment_Project.Models.Apartment
@using System

@{
    ViewData["Title"] = "Details";
}

<h1>Apartment Details</h1>

<div class="row">
    <div class="col-md-4">
        @if (Model?.SomePhoto != null)
        {
            var base64 = Convert.ToBase64String(Model.SomePhoto);
            <img src="data:image;base64,@base64" alt="Apartment photo" class="img-fluid img-thumbnail" />
        }
        else
        {
            <div class="border p-4 text-muted">No photo available</div>
        }
    </div>
    <div class="col-md-8">
        <dl class="row">
            <dt class="col-sm-4">Title</dt>
            <dd class="col-sm-8">@Model.Title</dd>

            <dt class="col-sm-4">Location</dt>
            <dd class="col-sm-8">@Model.Location</dd>

            <dt class="col-sm-4">Description</dt>
            <dd class="col-sm-8">@Model.Description</dd>

            <dt class="col-sm-4">Price</dt>
            <dd class="col-sm-8">@Model.Price.ToString("C")</dd>

            <dt class="col-sm-4">Availability</dt>
            <dd class="col-sm-8">
                @if (Model.IsAvailable) { <span>Available</span> } else { <span>Not Available</span> }
            </dd>
        </dl>

        <a asp-action="Edit" asp-route-id="@Model.ID" class="btn btn-primary">Edit</a>
        <a asp-action="Index" class="btn btn-secondary">Back to list</a>
    </div>
</div>
