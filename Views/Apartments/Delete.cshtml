@model Apartment_Project.Models.Apartment
@using System

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete Apartment</h1>

<div class="alert alert-warning">
    Are you sure you want to delete this apartment?
</div>

<div class="row mb-3">
    <div class="col-md-4">
        @if (Model?.SomePhoto != null)
        {
            var base64 = Convert.ToBase64String(Model.SomePhoto);
            <img src="data:image;base64,@base64" alt="Apartment photo" class="img-fluid img-thumbnail" />
        }
    </div>
    <div class="col-md-8">
        <h4>@Model.Title</h4>
        <p>@Model.Description</p>
        <p><strong>Location:</strong> @Model.Location</p>
        <p><strong>Price:</strong> @Model.Price.ToString("C")</p>
        <p><strong>Availability:</strong> @(Model.IsAvailable ? "Available" : "Not Available")</p>
    </div>
</div>

<form asp-action="DeleteConfirmed" asp-route-id="@Model.ID" method="post">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
